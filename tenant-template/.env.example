# Tenant Identifier (Used for container naming)
TENANT_NAME=default

# Mapped Host Ports (Change these to prevent port clashing when running multiple tenants)
HTTP_PORT=9001
SSH_PORT=2201

# Database Configuration (Injected into the tenant's PostgreSQL container and Laravel app)
POSTGRES_DB=tenant_db
POSTGRES_USER=tenant_user
POSTGRES_PASSWORD=tenant_pass
